# Leave blank for first-run onboarding at http://localhost:3001, or set manually.
# Allegro API credentials (developer.allegro.pl)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# true = sandbox (allegro.pl.allegrosandbox.pl), false = production
ALLEGRO_SANDBOX=true

# Optional. Defaults are shown; set them only when the default does not fit.
# ALLEGRO_REDIRECT_URI=http://localhost:3001/api/orders/auth/callback
# ALLEGRO_TIMEOUT=30
# Test the label flow without creating a real (paid) shipment: fake dry-run-… ids,
# blank PDF labels, no Allegro call. For the beta instance only.
# PACKING_SHIPMENT_DRY_RUN=true
# Where the browser lands after the Allegro callback
# PACKING_BASE_URL=http://localhost:3001
# Extra origins allowed to call the API (comma separated); the UI itself is same-origin
# PACKING_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Kept only for backend/api/inpost_shipx.py, which the current label flow does not use.
INPOST_SHIPX_TOKEN=

# Leave blank to generate during first-run onboarding (shown once; save it).
# Or set at least 32 characters manually:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PACKING_ACCESS_TOKEN=
